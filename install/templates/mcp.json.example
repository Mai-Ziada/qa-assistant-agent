{
  "_comment": "MCP servers for this project. Secret values are left empty — fill them in, or point them at an environment variable. This file is git-ignored; .mcp.json.example beside it is the committed copy. Delete any server you do not use.",
  "mcpServers": {
    "atlassian": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://mcp.atlassian.com/v1/sse"],
      "env": {}
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": ""
      }
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y", "@playwright/mcp@latest",
        "--caps=vision",
        "--viewport-size=1920x1080"
      ],
      "env": {}
    }
  }
}
