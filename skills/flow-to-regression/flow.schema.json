{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "flow.schema.json",
  "title": "FLOW_TO_REGRESSION Typed IR",
  "description": "Canonical source of truth for a discovered or provided business flow. flow.mmd is only a rendered view of this document. Every node carries evidence and a verified flag; unverified nodes may render but must not enter journeys, test cases, the regression plan, or the agentic-regression handoff.",
  "type": "object",
  "additionalProperties": false,
  "required": ["flow", "nodes", "edges"],
  "properties": {
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "slug", "title", "status", "input_mode"],
      "properties": {
        "id": { "type": "string" },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$|^[a-z0-9]+(-[a-z0-9]+)*$" },
        "title": { "type": "string" },
        "project": { "type": ["string", "null"] },
        "input_mode": {
          "enum": ["full_requirements", "partial_idea", "url_discovery", "url_feature_focus"]
        },
        "source_url": { "type": ["string", "null"] },
        "feature_focus": { "type": ["string", "null"] },
        "coverage_note": {
          "type": ["string", "null"],
          "description": "Honest scope of evidence, e.g. 'pre-auth only', 'focus + one hop', 'observed without exercising'."
        },
        "status": { "enum": ["draft", "chart-approved", "plan-approved", "emitted"] }
      }
    },

    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "label", "evidence", "verified"],
        "properties": {
          "id": { "type": "string", "pattern": "^N-[a-z0-9-]+$" },
          "type": {
            "enum": [
              "actor", "system", "action", "decision", "validation",
              "business-rule", "state-change", "transition",
              "sync-point", "risk", "success", "failure"
            ]
          },
          "label": { "type": "string" },
          "actor": { "type": ["string", "null"] },
          "role": { "type": ["string", "null"] },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "confidence"],
            "properties": {
              "source": {
                "enum": [
                  "user_input", "url_discovery", "sweep", "journey",
                  "docs", "memory", "domain_review", "inferred"
                ]
              },
              "ref": {
                "type": ["string", "null"],
                "description": "Concrete pointer: URL, selector, doc line, memory slug. No ref => cannot be verified:true."
              },
              "confidence": { "enum": ["high", "medium", "low"] },
              "observed_at": { "type": ["string", "null"] }
            }
          },
          "verified": {
            "type": "boolean",
            "description": "true only when backed by a concrete observed/provided ref. Inferred-between steps are false."
          }
        }
      }
    },

    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "type"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "type": { "enum": ["success", "failure", "transition", "approval"] },
          "label": { "type": ["string", "null"] },
          "guard": { "type": ["string", "null"] }
        }
      }
    },

    "diagrams": {
      "type": "array",
      "description": "Flow-driven, not a fixed template set. Each entry is a Mermaid view to render from the nodes it includes.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "includes"],
        "properties": {
          "kind": { "type": "string", "description": "e.g. overview, detailed, admin, client, approval, workflow" },
          "includes": { "type": "array", "items": { "type": "string" } }
        }
      }
    },

    "assumptions": {
      "type": "array",
      "description": "Open questions / unverified beliefs. Any unresolved assumption escalates Gate 2 to a hard stop.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "resolved"],
        "properties": {
          "text": { "type": "string" },
          "node_ref": { "type": ["string", "null"] },
          "resolved": { "type": "boolean" }
        }
      }
    }
  }
}
